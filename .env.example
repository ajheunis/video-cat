# Copy to .env and adjust for your machine. .env is git-ignored.

# Folder containing videos_catalog.duckdb
CATALOG_DIR=C:/path/to/catalog

# Drives/folders holding the videos (MEDIA_2 is optional)
MEDIA_1=H:/
MEDIA_2=F:/

# Map catalog storage roots to the mounts above (/media/1, /media/2)
VB_PATH_MAP=H:/=/media/1;F:/=/media/2

# Optional display names for storage roots
VB_ROOT_LABELS=H:/=H: Processed;F:/=F: Raw

# Host port (bound to 127.0.0.1 only)
VB_PORT=8000
